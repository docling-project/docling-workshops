# ============================================================
# Docling for IBM watsonx — Lab environment variables
#
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit credentials.
# ============================================================

# ── Docling for IBM watsonx (managed service) ────────────────
# Obtain these from the dashboard: Settings → API Keys
DOCLING_SERVICE_URL=https://your-docling-service.example.com
DOCLING_SERVICE_API_KEY=your-api-key-here

# ── Docling MCP server (uses the same managed service) ───────
DOCLING_MCP_CONVERSION_MODE=remote
DOCLING_MCP_SERVICE_URL=${DOCLING_SERVICE_URL}
DOCLING_MCP_SERVICE_API_KEY=${DOCLING_SERVICE_API_KEY}

# ── watsonx.ai (for the RAG generation step) ─────────────────
WX_API_KEY=your-watsonx-api-key
WX_PROJECT_ID=your-watsonx-project-id
